# Copie este arquivo para .env.local e preencha com os valores reais.
# Nunca commite .env.local — ele já está no .gitignore.

# Público (vai para o bundle do navegador — use a anon key do Supabase, nunca a service role key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Público também — chave do Google Maps restrita por HTTP referrer (domínio do site) no
# Google Cloud Console, e por API (Geocoding, Maps JavaScript, Directions). Sem isso, o app
# funciona normal mas sem mapa, sem geocodificação e sem otimização de rota.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Servidor apenas (NÃO prefixar com VITE_, senão vaza para o navegador).
# Usada só pela função serverless em /api/extract-pdf.js. Configure nas
# Environment Variables do projeto na Vercel.
ANTHROPIC_API_KEY=sk-ant-...
